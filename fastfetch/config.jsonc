{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": " ›  "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "red",  // = color1
        },
        {
            "type": "custom",
            "key": "MCH ",
            "keyColor": "green",
            "format": "ThinkPad T480s",
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "blue",
        },
        {
            "type": "packages",
            "format": "{xbps} (xbps)",
            "key": "PKG ",
            "keyColor": "magenta",  
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "red", 
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "red", 
        },
        "break",
    ]
}