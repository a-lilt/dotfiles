@theme "/dev/null"

configuration {
    show-icons: false;
    font: "PP Right Serif Mono Regular 15px";
}

* {
    background-color: #ffffff;
    text-color: #000000;
    border: 0;
    margin: 0;
    spacing: 0;
}

window {
    location: north;
    anchor: north;
    width: 100%;
    padding: 3px;
    children: [ horibox ];
}

horibox {
    orientation: horizontal;
    children: [ prompt, entry, listview ];
}

prompt {
    padding: 0 8px 0 0;
}

entry {
    expand: false;
    width: 15em;
}

listview {
    layout: horizontal;
    lines: 100;
    spacing: 4px;
}

element {
    padding: 0 6px;
}

element selected {
    background-color: #000000;
    text-color: #ffffff;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
